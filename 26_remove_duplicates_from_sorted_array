class Solution:
    def removeDuplicates(self, nums: list[int]) -> int:
        output = 0
        for i in range(len(nums)):
            if nums[output] != nums[i]:
                output += 1
                nums[output] = nums[i]
        return output + 1

solution = Solution()
nums1 = [1, 1, 2]
length1 = solution.removeDuplicates(nums1)
print(length1)  # Output: 2
print(nums1[:length1])  # Output: [1, 2]
